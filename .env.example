# PostgreSQL (local: `npm run db:up` sobe o container do docker-compose.yml)
DATABASE_URL=postgresql://linkbio:linkbio@localhost:5435/linkbio

# Segredo usado para gerar o identificador anônimo de visitante (analytics).
# Gere um valor aleatório: openssl rand -base64 32
APP_SECRET=troque-este-valor

# URL pública do site (metadata, sitemap, robots, JSON-LD, links dos e-mails).
# Produção: https://bio.codepath.dev.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail (recuperação de senha) via Resend, com o domínio codepath.dev.br verificado no Resend.
# Sem estas variáveis, em dev o link aparece no terminal.
# RESEND_API_KEY=
# MAIL_FROM=Linkbio by CodePath <nao-responda@codepath.dev.br>
